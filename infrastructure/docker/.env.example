# Airflow runtime environment for Docker Compose
# Copy this file to infrastructure/docker/.env and fill in the values.

# Airflow secret keys
FERNET_KEY=CHANGEME_GENERATE_ONE
SECRET_KEY=CHANGEME_GENERATE_ONE

# Airflow metadata database connection.
# The default uses the built-in postgres service in docker-compose.
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow

# Use service account credentials in the container or configure Google Application Default Credentials
# if you want dbt-bigquery to authenticate to BigQuery from the Airflow container.
# Example: export GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/dbt/credentials.json
